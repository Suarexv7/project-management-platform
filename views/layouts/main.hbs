<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Management</title>
    <!-- Bootstrap para que se vea bonito sin escribir CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <!-- Barra de navegación -->
    <nav class="navbar navbar-dark bg-dark px-4">
        <a class="navbar-brand" href="/web/projects">📋 Project Manager</a>
        <div class="d-flex gap-2">
            {{#if user}}
            <a href="/web/projects/new" class="btn btn-primary btn-sm">+ Nuevo Proyecto</a>
            <a href="/web/auth/logout" class="btn btn-outline-light btn-sm">Cerrar sesión 👤 {{user.name}}</a>
            {{else}}
            <a href="/web/auth/login" class="btn btn-outline-light btn-sm">Iniciar sesión</a>
            <a href="/web/auth/register" class="btn btn-primary btn-sm">Registrarse</a>
            {{/if}}
        </div>
    </nav>

    <!-- Aquí se inyecta el contenido de cada página -->
    <div class="container mt-4">
        {{{body}}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>